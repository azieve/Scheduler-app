# Test Environment Configuration
NODE_ENV=test
PORT=3001

# Test Database Configuration
DATABASE_URL=postgresql://scheduler_user:scheduler_password@localhost:5432/scheduler_test_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scheduler_test_db
DB_USER=scheduler_user
DB_PASSWORD=scheduler_password

# Test Authentication
JWT_SECRET=test-secret-jwt-key-2024
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=4

# Mock Google OAuth (for testing)
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Test Frontend URL
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=error